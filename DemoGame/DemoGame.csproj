<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DemoGame</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
      <!-- Reference to the Renboko Engine project -->
<ProjectReference Include="../MainEngine/RenbokoEngine.csproj" /> 
    <!-- MonoGame for DesktopGL -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4" />
    
 </ItemGroup>
<ItemGroup>
  <MonoGameContentReference Include="Content\\Content.mgcb" />
</ItemGroup>
<ItemGroup>
  <!-- Ensure raw content files (xnb, png, spritefont, etc.) are copied to the build output
       so ContentManager can load them at runtime even if MGCB didn't run in this build. -->
  <Content Include="Content\\**\\*.*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </Content>
</ItemGroup>
</Project>
